# =============================================================================
# Urban Air Quality Assistant — Environment Configuration Example
# Copy to .env.local for local overrides. NEVER commit .env or .env.local.
# Zero API keys are required to run the full application!
# =============================================================================

# Runtime environment: development | test | production
NODE_ENV=development

# Optional: Enable Demo Mode by default (true | false). Demo presets remain
# selectable in UI regardless of this setting.
NEXT_PUBLIC_DEFAULT_DEMO_MODE=false

# Upstream API Base URLs (strictly allowlisted in server SSRF guard)
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Optional Server-Side LLM Provider Keys (NEVER prefix with NEXT_PUBLIC_)
# If neither key is set, the assistant automatically uses the grounded
# deterministic rule-based engine with full smog/routine/impact guidance.
# LLM_PROVIDER=auto # auto | gemini | anthropic | fallback
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Rate limiting configuration (server-side token bucket)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Structured logger level: debug | info | warn | error | silent
LOG_LEVEL=info
