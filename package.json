{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "GenAI-powered Urban Air Quality Assistant helping families and communities navigate severe winter smog and urban air pollution.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -g \"Accessibility audit\"",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "node scripts/check-structure.mjs && npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build && npm run audit:deps"
  },
  "dependencies": {
    "next": "^15.5.29",
    "next-intl": "^4.16.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.2.1",
    "fast-check": "^4.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "knip": {
    "ignoreDependencies": [
      "axe-core",
      "eslint-config-next",
      "eslint-plugin-import",
      "eslint-plugin-jsx-a11y"
    ]
  }
}
